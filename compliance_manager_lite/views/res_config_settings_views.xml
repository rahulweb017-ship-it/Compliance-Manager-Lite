<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.compliance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Compliance Manager" name="compliance_manager_lite">
                    <block title="Expiry Reminders" name="compliance_reminders">
                        <setting string="Reminder Schedule"
                                 help="Days before expiry when reminder emails are sent.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="compliance_reminder_days_1" class="col-lg-6 o_light_label"/>
                                    <field name="compliance_reminder_days_1"/>
                                </div>
                                <div class="row mt8">
                                    <label for="compliance_reminder_days_2" class="col-lg-6 o_light_label"/>
                                    <field name="compliance_reminder_days_2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="compliance_reminder_days_3" class="col-lg-6 o_light_label"/>
                                    <field name="compliance_reminder_days_3"/>
                                </div>
                                <div class="row mt8">
                                    <label for="compliance_reminder_days_4" class="col-lg-6 o_light_label"/>
                                    <field name="compliance_reminder_days_4"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_compliance_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'compliance_manager_lite'}</field>
    </record>

</odoo>
