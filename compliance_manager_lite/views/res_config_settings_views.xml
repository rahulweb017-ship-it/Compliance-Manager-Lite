<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.compliance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Compliance Manager" name="compliance_manager_lite">
                    <block title="Expiry Status" name="compliance_status">
                        <setting string="Expiring Soon Threshold"
                                 help="A document counts as Expiring Soon once it is within this many days of its expiry date.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <field name="compliance_expiring_soon_threshold"
                                           class="col-lg-3"/>
                                    <span class="col-lg-6 o_form_label">days before expiry</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Expiry Reminders" name="compliance_reminders">
                        <setting string="Reminder Schedule"
                                 help="Reminder emails are sent this many days before expiry. Each category may override this with a schedule of its own.">
                            <div class="content-group">
                                <div class="mt8">
                                    <button name="action_open_reminder_rules"
                                            type="object"
                                            string="Configure Reminder Schedule"
                                            class="btn-link"
                                            icon="east"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_compliance_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'compliance_manager_lite'}</field>
    </record>

</odoo>
