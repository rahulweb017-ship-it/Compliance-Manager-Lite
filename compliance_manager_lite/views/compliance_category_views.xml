<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_compliance_category_list" model="ir.ui.view">
        <field name="name">compliance.category.list</field>
        <field name="model">compliance.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="record_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_compliance_category_form" model="ir.ui.view">
        <field name="name">compliance.category.form</field>
        <field name="model">compliance.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Vehicle Insurance"/></h1>
                    </div>
                    <group>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Reminder Schedule" name="reminders">
                            <div class="text-muted mb-2">
                                Intervals used for documents in this category. Leave the
                                list empty to fall back to the global default schedule.
                            </div>
                            <field name="reminder_rule_ids" nolabel="1"
                                   context="{'default_category_id': id}">
                                <list string="Reminder Schedule" editable="bottom">
                                    <field name="days"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_compliance_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">compliance.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first compliance category</p>
            <p>Group records by type such as Licenses, Contracts or Certifications.</p>
        </field>
    </record>

</odoo>
