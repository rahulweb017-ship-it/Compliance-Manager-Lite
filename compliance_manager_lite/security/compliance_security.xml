<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="group_compliance_user" model="res.groups">
        <field name="name">Compliance User</field>
        <field name="comment">View compliance records assigned to the user.</field>
    </record>

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_compliance_user'))]"/>
        <field name="comment">Create and manage all compliance records and configuration.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_compliance_manager'))]"/>
    </record>

    <record id="rule_compliance_record_user_own" model="ir.rule">
        <field name="name">Compliance: users see their assigned records</field>
        <field name="model_id" ref="model_compliance_record"/>
        <field name="domain_force">[('responsible_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_compliance_record_manager_all" model="ir.rule">
        <field name="name">Compliance: managers see all records</field>
        <field name="model_id" ref="model_compliance_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
